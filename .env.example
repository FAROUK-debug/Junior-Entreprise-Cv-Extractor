# Copy to .env and fill in. .env is gitignored: real keys never go in git, ClickUp or chat.
# Ask Ahmed for the values. On Railway each service gets only its own block.

# ── web (Next.js, repo root) ─────────────────────────────────────────────
# Browser-safe: NEXT_PUBLIC_ values are visible to anyone, so only these two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses every database rule: never in a NEXT_PUBLIC_ name, never in client code.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed
NVIDIA_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── worker (Python, worker/) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MISTRAL_API_KEY=
# The only embedding model in this project. Same value as the web block, always.
MISTRAL_EMBED_MODEL=mistral-embed
GEMINI_API_KEY=
